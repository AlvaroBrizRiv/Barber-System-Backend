# =====================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — Barbería System
# =====================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env"
# 2. Completa los valores con tus credenciales REALES
# 3. NUNCA subas el archivo .env a GitHub (ya está en .gitignore)
# =====================================================================

# ─────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────
# URL de conexión JDBC a MySQL
DB_URL=jdbc:mysql://localhost:3306/barberia_db?useSSL=false&serverTimezone=America/Santiago&characterEncoding=UTF-8

# Usuario de la base de datos (NO uses "root" en producción)
DB_USER=barberia_user

# Contraseña del usuario de base de datos
DB_PASSWORD=tu_contraseña_segura_aqui

# Tamaño máximo del pool de conexiones HikariCP
DB_POOL_SIZE=10

# ─────────────────────────────────────────
# SEGURIDAD — JWT
# ─────────────────────────────────────────
# Clave secreta para firmar los tokens JWT
# IMPORTANTE: Debe tener al menos 32 caracteres aleatorios
# Genera una en: https://www.random.org/strings/
JWT_SECRET=reemplaza_con_una_clave_secreta_de_minimo_32_caracteres_aleatoria

# Tiempo de expiración del token en milisegundos (86400000 = 24 horas)
JWT_EXPIRATION_MS=86400000

# ─────────────────────────────────────────
# SERVIDOR HTTP (Javalin)
# ─────────────────────────────────────────
# Puerto en el que escucha la API REST
SERVER_PORT=7070

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5500

# ─────────────────────────────────────────
# ENTORNO
# ─────────────────────────────────────────
# Valores posibles: development | production
APP_ENV=development
