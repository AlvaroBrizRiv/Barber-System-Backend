# =====================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — Barbería System
# =====================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env"
# 2. Completa los valores con tus credenciales REALES
# 3. NUNCA subas el archivo .env a GitHub (ya está en .gitignore)
# =====================================================================

# ─────────────────────────────────────────
# BASE DE DATOS — SQL Server (SSMS LocalDB)
# ─────────────────────────────────────────
# Server Name en SSMS: (localdb)\MSSQLLocalDB
DB_URL=jdbc:sqlserver://(localdb)\MSSQLLocalDB;databaseName=barberia_db;encrypt=false;trustServerCertificate=true

# ─── Alternativa: PostgreSQL / Supabase ───
# 1. Ejecuta database/postgres/schema.sql y datos_prueba.sql en el SQL Editor de Supabase.
# 2. Supabase → Project Settings → Database → Connection string (Session pooler, puerto 5432).
# 3. Reemplaza DB_URL / DB_USER / DB_PASSWORD (no hay que tocar código Java):
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<tu-password-de-base-de-datos>

# Usuario de la base de datos (creado en schema.sql)
DB_USER=barberia_user

# Contraseña del usuario de base de datos
DB_PASSWORD=Barberia1234!

# Tamaño máximo del pool de conexiones HikariCP
DB_POOL_SIZE=10

# ─────────────────────────────────────────
# SEGURIDAD — JWT
# ─────────────────────────────────────────
# Clave secreta para firmar los tokens JWT (mínimo 32 caracteres)
JWT_SECRET=barber_system_secret_key_2026_segura_jwt_token_32chars_min

# Tiempo de expiración del token en milisegundos (86400000 = 24 horas)
JWT_EXPIRATION_MS=86400000

# ─────────────────────────────────────────
# SERVIDOR HTTP (Javalin)
# ─────────────────────────────────────────
# Puerto en el que escucha la API REST
SERVER_PORT=7070

# Origen(es) exactos del frontend separados por coma. "*" NO está permitido (el servidor no arranca).
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# ─────────────────────────────────────────
# CORREO (SMTP) — códigos de "¿Olvidaste tu contraseña?"
# ─────────────────────────────────────────
# Si SMTP_HOST queda vacío, en desarrollo el código se muestra en la consola
# del servidor (en producción no se muestra y no se envía nada).
#
# Ejemplo Gmail: requiere verificación en 2 pasos y una "contraseña de aplicación"
# (Cuenta de Google → Seguridad → Contraseñas de aplicaciones). No uses tu contraseña normal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
SMTP_FROM=tu_correo@gmail.com
# 587 → SMTP_STARTTLS=true, SMTP_SSL=false · 465 → SMTP_STARTTLS=false, SMTP_SSL=true
SMTP_STARTTLS=true
SMTP_SSL=false

# ─────────────────────────────────────────
# ENTORNO
# ─────────────────────────────────────────
# Valores posibles: development | production
APP_ENV=development
