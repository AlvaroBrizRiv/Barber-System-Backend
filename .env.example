# =====================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — Barbería System
# =====================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env"
# 2. Completa los valores con tus credenciales REALES
# 3. NUNCA subas el archivo .env a GitHub (ya está en .gitignore)
# =====================================================================

# ─────────────────────────────────────────
# BASE DE DATOS — SQL Server (SSMS LocalDB)
# ─────────────────────────────────────────
# Server Name en SSMS: (localdb)\MSSQLLocalDB
DB_URL=jdbc:sqlserver://(localdb)\MSSQLLocalDB;databaseName=barberia_db;encrypt=false;trustServerCertificate=true

# Usuario de la base de datos (creado en schema.sql)
DB_USER=barberia_user

# Contraseña del usuario de base de datos
DB_PASSWORD=Barberia1234!

# Tamaño máximo del pool de conexiones HikariCP
DB_POOL_SIZE=10

# ─────────────────────────────────────────
# SEGURIDAD — JWT
# ─────────────────────────────────────────
# Clave secreta para firmar los tokens JWT (mínimo 32 caracteres)
JWT_SECRET=barber_system_secret_key_2026_segura_jwt_token_32chars_min

# Tiempo de expiración del token en milisegundos (86400000 = 24 horas)
JWT_EXPIRATION_MS=86400000

# ─────────────────────────────────────────
# SERVIDOR HTTP (Javalin)
# ─────────────────────────────────────────
# Puerto en el que escucha la API REST
SERVER_PORT=7070

# Origen permitido para CORS (URL del frontend o * en desarrollo)
CORS_ORIGIN=*

# ─────────────────────────────────────────
# ENTORNO
# ─────────────────────────────────────────
# Valores posibles: development | production
APP_ENV=development
