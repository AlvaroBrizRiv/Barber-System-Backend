<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mycompany</groupId>
    <artifactId>ProyectoBarberia</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <exec.mainClass>com.mycompany.proyectobarberia.ProyectoBarberia</exec.mainClass>
        <!-- Versiones centralizadas -->
        <javalin.version>6.3.0</javalin.version>
        <slf4j.version>2.0.13</slf4j.version>
        <jjwt.version>0.12.6</jjwt.version>
        <bcrypt.version>0.10.2</bcrypt.version>
        <gson.version>2.11.0</gson.version>
        <hikari.version>5.1.0</hikari.version>
        <dotenv.version>3.0.2</dotenv.version>
        <mssql.version>12.8.1.jre11</mssql.version>
        <postgresql.version>42.7.4</postgresql.version>
        <!-- Pruebas -->
        <junit.version>5.14.4</junit.version>
        <mockito.version>5.24.0</mockito.version>
        <surefire.version>3.6.1</surefire.version>
    </properties>

    <dependencies>
        <!-- ═══════════════════════════════════════════════════ -->
        <!--  BASE DE DATOS                                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>${mssql.version}</version>
        </dependency>

        <!-- PostgreSQL / Supabase: se activa cambiando DB_URL en .env (jdbc:postgresql://...) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>

        <!-- API de SLF4J explícita para evitar versión 1.7 transitiva de HikariCP -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- Pool de conexiones — evita abrir/cerrar conexiones en cada request -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikari.version}</version>
        </dependency>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--  SERVIDOR HTTP REST (sin Tomcat externo)           -->
        <!-- ═══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>${javalin.version}</version>
        </dependency>

        <!-- Logger requerido por Javalin -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--  SERIALIZACIÓN JSON                                 -->
        <!-- ═══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--  SEGURIDAD — JWT + BCrypt                          -->
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- API pública de JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <!-- Implementación interna (runtime) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Serialización JSON para JWT (usa Gson) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-gson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Hash seguro de contraseñas con BCrypt -->
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
            <version>${bcrypt.version}</version>
        </dependency>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--  CONFIGURACIÓN — Variables de entorno (.env)       -->
        <!-- ═══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>${dotenv.version}</version>
        </dependency>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--  PRUEBAS                                            -->
        <!-- ═══════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Expone la ruta del JAR de Mockito como propiedad para cargarlo como agente -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Ejecución de pruebas (mvn test) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!-- Mockito como agente: evita el aviso de carga dinámica en JDK 21+ -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                    <!-- Valores solo para pruebas: no dependen del .env local -->
                    <environmentVariables>
                        <JWT_SECRET>clave_de_pruebas_unitarias_con_mas_de_32_caracteres</JWT_SECRET>
                        <JWT_EXPIRATION_MS>3600000</JWT_EXPIRATION_MS>
                    </environmentVariables>
                </configuration>
            </plugin>

            <!-- Plugin para crear un JAR ejecutable con todas las dependencias -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.mycompany.proyectobarberia.ProyectoBarberia</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
